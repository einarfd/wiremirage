package example:signed;

interface host-api {
  give-signed: func() -> s64;   // host hands JS a negative
}

world guest {
  import host-api;
  export sink-s64: func(v: s64);        // negative INTO js (param), never returned
  export source-s64: func() -> s64;     // negative OUT of js, no params
  export pull-from-import: func();      // negative INTO js from an import return, never returned
  export pull-and-return: func() -> s64; // both: lift from import, then lower out
  export sink-u64: func(v: u64);        // control: u64 with bit 63 set
}
