package wiremirage:handler@0.1.0;

// Engine-internal extension. Lives in the same package as the
// user-facing `handler` world because componentize-js wants every
// wit file in a build's wit directory to declare the same package
// identifier. The split between user-facing and engine-internal is
// preserved by keeping each world in its own file.
//
// The `engine` world looks like `handler` (same export shape, same
// store/log imports) but adds a host import that delivers the
// route's source at request time.

interface engine-host {
  // Returns the JavaScript source for the matched route. Called
  // once per `handle` invocation by the engine shim. The bytes are
  // expected to be UTF-8 JS, evaluated as a script (no ES-module
  // export keywords). The TS→JS transpile that produces this string
  // is responsible for the export → script-shape rewrite.
  get-source: func() -> string;
}

// Streaming-response host imports (ADR-0022). See the repo-root
// `wit/engine.wit` copy for the full contract notes. `start` commits
// status + headers and switches to streaming mode; `write-chunk`
// flushes a chunk (false = client gone); `finish` ends the body.
interface response-stream {
  use http.{header};

  start: func(status: u16, headers: list<header>);
  write-chunk: func(bytes: list<u8>) -> bool;
  finish: func();
}

// Outbound-callback host import (ADR-0034). See the repo-root `wit/engine.wit`
// copy for the full contract notes. The host fires the callback once, on a
// background task, after `delay-ms`, after the response is sent. `schedule`
// returns err synchronously when callbacks aren't available (host egress off,
// or the group hasn't opted in); the per-IP egress check is at fire time.
interface callback {
  use http.{header};

  schedule: func(
    url: string,
    method: string,
    headers: list<header>,
    body: list<u8>,
    delay-ms: u64,
  ) -> result<_, string>;
}

world engine {
  import store;
  import log;
  import clock;
  import engine-host;
  import response-stream;
  import callback;

  use store.{bucket};
  use http.{request, response};

  export handle: func(
    req: request,
    route-store: borrow<bucket>,
    group-store: borrow<bucket>,
  ) -> response;
}
